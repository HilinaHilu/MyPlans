@page "/showplans"
@inject IPlanService planService

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Category</th>
            <th>Start Date</th>
            <th>End Date</th>
        </tr>
    </thead>
    <tbody>
        @if (plans != null && plans.Any())
        {
            @foreach (var plan in plans)
            {
                <tr>
                    <td>@plan.Titel</td>
                    <td>@plan.Description</td>
                    <td>@plan.category</td>
                    <td>@plan.start.ToString("dd-MM-yyyy HH:mm")</td>
                    <td>@plan.end.ToString("dd-MM-yyyy HH:mm")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No plans available</td>
            </tr>
        }
    </tbody>
</table>

@code {
	List<Plan> plans = new List<Plan>();

	protected override async Task OnInitializedAsync()
	{
		List<Plan> result = await planService.getAllPlansAsync();
		if (result != null) {
			plans = result;
		}

	}
}
